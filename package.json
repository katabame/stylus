{
  "name": "stylum",
  "description": "Modern CSS preprocessor based on Stylus: robust, expressive, and feature-rich CSS superset",
  "version": "0.1.0",
  "author": "katabame",
  "contributors": [
    "TJ Holowaychuk <tj@vision-media.ca> (original Stylus author)",
    "Stylus maintainers (https://github.com/stylus/stylus)"
  ],
  "keywords": [
    "css",
    "parser",
    "style",
    "stylesheets",
    "preprocessor",
    "stylus",
    "language"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katabame/stylum.git"
  },
  "main": "./index.js",
  "browserify": "./lib/browserify.js",
  "engines": {
    "node": ">=16"
  },
  "bin": {
    "stylum": "bin/stylum"
  },
  "scripts": {
    "prepublish": "npm prune",
    "test": "mocha test/ test/middleware/ --require chai --bail --check-leaks --reporter dot"
  },
  "dependencies": {
    "@adobe/css-tools": "~4.3.3",
    "debug": "^4.3.2",
    "glob": "^10.4.5",
    "sax": "~1.4.1",
    "source-map": "^0.7.3"
  },
  "devDependencies": {
    "chai": "^4.3.6",
    "mocha": "^11.1.0"
  },
  "bugs": {
    "url": "https://github.com/katabame/stylum/issues"
  },
  "homepage": "https://github.com/katabame/stylum",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "license": "MIT"
}
