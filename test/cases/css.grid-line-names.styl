.a
  grid-template-columns: [full-start] minmax(1rem, 1fr) [content-start] minmax(0, 60rem) [content-end full-end]
  grid-template-rows: [header] auto [main] 1fr
  grid-template: repeat(2, [row] 1fr) / [col] auto

.b {
  grid-template-columns: [a] 1fr [b];
}

list = 1 2 3
.c
  subscript: list[1]
  subscript-space: list [1]
