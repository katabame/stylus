.a
  --rgb: rgb(0 0 0 / 50%)
  --rgba: rgba(10 20 30 / .3)
  --hsl: hsl(120deg 50% 50% / .5)
  --hsla: hsla(0 100% 50% / 25%)
  --opaque: rgb(255 0 0)
  --legacy: rgb(255 / 2, 0, 0)
  --darken: darken(rgb(255 0 0 / 50%), 10%)
  --lab: lab(50% 40 59.5 / .5)
  --oklch: oklch(70% 0.1 200 / 50%)
  --mix: color-mix(in srgb, red 50%, blue)
  --mix-hue: color-mix(in oklch longer hue, red, blue)
  --relative: rgb(from red r g b / 50%)
  --var: rgb(var(--r) 0 0)
  --var-alpha: rgba(0, 0, 0, var(--a))
  --none: rgb(none 0 0)
  --light-dark: light-dark(#000, #fff)
