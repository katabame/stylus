.a
  --computed-min: min(1px, 2px)
  --computed-max: max(1px, 5px, 3px)
  --unitless: min(3, 1, 2)
  --mixed: min(10px, 5vh)
  --percent: max(100%, 500px)
  --many: max(1em, 2rem, 3px)
  --var: max(10px, var(--x))
  --calc: max(calc(1px + 2px), 3px)
  --round: round(1.5px)
  --round-precision: round(1.2345, 2)
  --round-strategy: round(up, 10px, 3px)
  --round-interval: round(10px, 3px)
  --abs: abs(-2px)
  --abs-var: abs(var(--x))
  --clamp: clamp(1rem, 2.5vw, 2rem)
