.a { color: if(style(--x: 1): red; else: blue); }

.b
  width: if(media(width > 600px): 10px; supports(display: grid): 20px; else: 30px)
  margin: 0 if(not style(--x): 1px; else: 2px) 0
  padding: if(style(--s: "a;)b"): 1px; else: 2px)

// the Stylus `if` keyword is unaffected
x = 1
f(a)
  if(a)
    return 1
  return 2

.c
  color: red if x
  width: f(true)
  if x
    height: 1px

// Stylus values are evaluated in branches, `{expr}` is interpolated in conditions
bp = 600px
brand = #abc
.d
  color: if(style(--x: 1): brand; else: darken(brand, 10%))
  width: if(media(width > {bp}): bp * 2; else: 1px + 2px)
  combined: if(style(--x: 1) and media(print): 1px; else: 2px)
